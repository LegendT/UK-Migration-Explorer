<table>
  <caption>Returns from the UK, year ending June 2026, and how each figure relates to the
  others</caption>
  <thead><tr><th scope="col">Count</th><th scope="col">Latest figure</th><th scope="col">How it relates to the total</th></tr></thead>
  <tbody>
    <tr><th scope="row">Enforced returns</th><td>{% figure "asylum/returns-enforced" %}&nbsp;returns</td><td>Carried out by the state. Part of the total below</td></tr>
    <tr><th scope="row">Voluntary returns</th><td>{% figure "asylum/returns-voluntary" %}&nbsp;returns</td><td>Not carried out by the state. Part of the total below, and about three-quarters of it</td></tr>
